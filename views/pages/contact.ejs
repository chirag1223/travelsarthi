<div id="contact" class="page-transition">
    <section class="py-32 bg-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-sky-50 rounded-full blur-[120px] opacity-60 -mr-40 -mt-40"></div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-4xl mb-20">
                <span class="text-sky-700 font-bold tracking-[0.3em] uppercase text-xs">Contact Us</span>
                <h1 class="text-5xl md:text-6xl font-extrabold text-slate-900 mt-4 mb-6 tracking-tight">
                    Let's Plan Your <span class="text-orange-600">Next Adventure</span>
                </h1>
                <div class="w-20 h-1.5 bg-sky-500 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-20">
                
                <div class="lg:col-span-7">
                    <h2 class="text-2xl font-bold text-slate-900 mb-2">Send us a Message</h2>
                    <p class="text-slate-600 mb-12 font-semibold">Fill out the form below and our experts will reach out to you.</p>
                    
                    <form id="contactForm" action="https://formsubmit.co/chirag.chelani17@gmail.com" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                        <!-- FormSubmit.co configuration -->
                        <input type="hidden" name="_subject" value="New Travel Inquiry from Website">
                        <input type="hidden" name="_template" value="table">
                        <input type="hidden" name="_next" value="https://yourwebsite.com/thank-you">
                        <input type="hidden" name="_captcha" value="false">
                        
                        <!-- Name Field -->
                        <div class="relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-orange-600 transition-colors">Full Name</label>
                            <input type="text" name="Full Name" placeholder="Travel Sarthi" required
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-orange-500 transition-all text-slate-900 font-bold placeholder:text-slate-400">
                        </div>

                        <!-- Contact Number -->
                        <div class="relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-sky-600 transition-colors">Contact Number</label>
                            <input type="text" name="Contact Number" placeholder="XXXXX XXXXX" required
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-sky-500 transition-all text-slate-900 font-bold placeholder:text-slate-400">
                        </div>
                        
                        <!-- Email -->
                        <div class="relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-sky-600 transition-colors">Email Address</label>
                            <input type="email" name="Email" placeholder="hello@travelsarthi.com" required
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-sky-500 transition-all text-slate-900 font-bold placeholder:text-slate-400">
                        </div>
                        
                        <!-- Date of Travel -->
                        <div class="relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-orange-600 transition-colors">Date of Travel</label>
                            <input type="text" name="Date of Travel" placeholder="Select your date"
                                onfocus="(this.type='date')" 
                                onblur="if(!this.value)this.type='text'"
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-orange-500 transition-all text-slate-900 font-bold placeholder:text-slate-400">
                        </div>
                        
                        <!-- Destination -->
                        <div class="md:col-span-2 relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-sky-600 transition-colors">Destination</label>
                            <input type="text" name="Destination" placeholder="e.g. Bali, Maldives, Kerala..." required
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-sky-500 transition-all text-slate-900 font-bold placeholder:text-slate-400">
                        </div>

                        <!-- Message -->
                        <div class="md:col-span-2 relative group">
                            <label class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 mb-2 block group-focus-within:text-orange-600 transition-colors">Your Message</label>
                            <textarea rows="4" name="Message" placeholder="Tell us about your dream trip..." required
                                class="w-full bg-transparent border-b-2 border-slate-200 py-3 outline-none focus:border-orange-500 transition-all text-slate-900 font-bold placeholder:text-slate-400 resize-none"></textarea>
                        </div>
                        
                        <!-- Submit Button -->
                        <div class="md:col-span-2 pt-6">
                            <button type="submit" class="px-12 h-14 bg-slate-900 text-white rounded-full font-bold hover:bg-sky-600 hover:shadow-2xl hover:shadow-sky-200 transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3 group">
                                Send Inquiry 
                                <i data-lucide="send" class="h-4 w-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Rest of your contact info remains the same -->
                <div class="lg:col-span-5 lg:pl-16">
                    <!-- ... your existing contact info ... -->
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Success Modal (optional) -->
<div id="successModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl p-8 max-w-md mx-4">
        <div class="text-center">
            <div class="h-16 w-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="check" class="h-8 w-8 text-green-600"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Thank You!</h3>
            <p class="text-slate-600 mb-6">Your inquiry has been sent successfully. Our travel expert will contact you soon.</p>
            <button onclick="closeModal()" class="px-6 py-3 bg-slate-900 text-white rounded-full font-bold hover:bg-sky-600 transition-colors">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    // Handle form submission
    document.getElementById('contactForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Get form data
        const formData = new FormData(this);
        
        // Send form data using fetch
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.ok) {
                // Show success modal
                document.getElementById('successModal').classList.remove('hidden');
                // Reset form
                this.reset();
            } else {
                alert('Something went wrong. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Something went wrong. Please try again.');
        });
    });

    function closeModal() {
        document.getElementById('successModal').classList.add('hidden');
    }

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
