<!-- Success Modal -->
<div id="successModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl transform transition-all">
        <div class="text-center">
            <div class="h-16 w-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="check" class="h-8 w-8 text-green-600"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Thank You!</h3>
            <p class="text-slate-600 mb-6">Your inquiry has been sent successfully. Our travel expert will contact you soon.</p>
            <button onclick="closeModal()" class="px-6 py-3 bg-slate-900 text-white rounded-full font-bold hover:bg-sky-600 transition-colors">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    // Handle form submission
    document.getElementById('contactForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Get form data
        const formData = new FormData(this);
        
        // Send form data using fetch
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.ok) {
                // Show success modal
                document.getElementById('successModal').classList.remove('hidden');
                // Reset form
                this.reset();
                // Reset any date field that might have been converted to type='date'
                const dateInput = document.querySelector('input[name="Date of Travel"]');
                if (dateInput && dateInput.type === 'date') {
                    dateInput.type = 'text';
                    dateInput.value = '';
                }
            } else {
                alert('Something went wrong. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Something went wrong. Please try again.');
        });
    });

    function closeModal() {
        document.getElementById('successModal').classList.add('hidden');
    }

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    } else {
        // Fallback in case lucide hasn't loaded
        window.addEventListener('load', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    }
    
    // Additional: ensure date input placeholder works on mobile consistently
    const dateInputs = document.querySelectorAll('input[onfocus="(this.type=\'date\')"]');
    dateInputs.forEach(input => {
        input.addEventListener('blur', function() {
            if (!this.value) {
                this.type = 'text';
            }
        });
    });
    
    // Responsive touch improvements: make phone/email links clickable with proper tap targets
    const contactLinks = document.querySelectorAll('.lg\\:col-span-5 a');
    contactLinks.forEach(link => {
        if (link.href && (link.href.startsWith('tel:') || link.href.startsWith('mailto:'))) {
            link.style.display = 'inline-block';
            link.style.padding = '4px 0';
        }
    });
</script>

